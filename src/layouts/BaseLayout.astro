---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const siteUrl = Astro.site?.href ?? "https://afu.im";
const ogImageUrl = ogImage ?? `${siteUrl}og-image.png`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Afu的博客" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="alternate" type="application/rss+xml" title="Afu的博客 RSS" href="/rss.xml" />

    <title>{title}</title>
  </head>
  <body>
    <div class="global-bg"></div>
    <Header />
    <main>
      <slot />
    </main>
    <button class="back-top" type="button" title="回到顶部" data-back-top aria-label="回到顶部">
      ↑
    </button>
    <Footer />
    <script is:inline>
      const root = document.documentElement;
      const header = document.querySelector("[data-site-header]");
      const backTop = document.querySelector("[data-back-top]");
      const themeToggle = document.querySelector("[data-theme-toggle]");
      const themeIcon = document.querySelector("[data-theme-icon]");
      const readProgress = document.querySelector("[data-read-progress]");
      const articleCards = [...document.querySelectorAll(".article-card")];
      const savedTheme = localStorage.getItem("theme");
      const prefersDarkMedia = window.matchMedia("(prefers-color-scheme: dark)");
      const reducedMotionMedia = window.matchMedia("(prefers-reduced-motion: reduce)");
      const prefersDark = prefersDarkMedia.matches;

      const applyTheme = (theme) => {
        root.dataset.theme = theme;
        localStorage.setItem("theme", theme);
        if (themeIcon) themeIcon.textContent = theme === "dark" ? "☀" : "☾";
        if (themeToggle) themeToggle.setAttribute("title", theme === "dark" ? "切换亮色" : "切换暗色");
        updateNavBg();
      };

      function updateNavBg() {
        if (!header) return;
        const styles = getComputedStyle(root);
        const r = styles.getPropertyValue('--nav-r').trim() || '28';
        const g = styles.getPropertyValue('--nav-g').trim() || '27';
        const b = styles.getPropertyValue('--nav-b').trim() || '25';
        const s = window.scrollY;
        const featuredEl = document.getElementById("featured");
        const threshold = featuredEl
          ? Math.max(200, featuredEl.getBoundingClientRect().top + s - 64)
          : 200;
        const alpha = Math.min(0.88, Math.max(0.1, 0.1 + (s / threshold) * 0.78)).toFixed(3);
        header.style.background = `linear-gradient(rgba(${r},${g},${b},${alpha}), rgba(${r},${g},${b},${alpha}))`;
      }

      const syncScrollState = () => {
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const progress = maxScroll > 0 ? Math.min(1, window.scrollY / maxScroll) : 0;
        header?.classList.toggle("is-scrolled", window.scrollY > 18);
        backTop?.classList.toggle("is-visible", window.scrollY > 420);
        if (readProgress) readProgress.style.transform = `scaleX(${progress})`;
        updateNavBg();
      };

      applyTheme(savedTheme === "dark" || (!savedTheme && prefersDark) ? "dark" : "light");
      syncScrollState();

      themeToggle?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        const isToDark = next === "dark";
        const oldBg = document.querySelector('.global-bg');

        const newBg = document.createElement('div');
        newBg.className = 'global-bg';
        newBg.style.backgroundImage = isToDark
          ? 'url(/assets/bg-dark.jpg)'
          : 'url(/assets/bg-light.jpg)';
        newBg.style.transition = 'clip-path 0.6s ease-in-out';
        newBg.style.clipPath = isToDark
          ? 'inset(0 0 100% 0)'
          : 'inset(100% 0 0 0)';
        document.body.insertBefore(newBg, document.body.firstChild);

        requestAnimationFrame(() => {
          newBg.style.clipPath = 'inset(0 0 0 0)';
          if (oldBg) {
            oldBg.style.transition = 'opacity 0.6s ease-in-out';
            oldBg.style.opacity = '0';
          }
        });

        root.classList.add('theme-transitioning');
        setTimeout(() => {
          applyTheme(next);
        }, 250);
        setTimeout(() => {
          if (oldBg) oldBg.remove();
          root.classList.remove('theme-transitioning');
        }, 650);
      });

      backTop?.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });

      /* 首页向下箭头 */
      const heroArrow = document.querySelector("[data-hero-arrow]");
      const featured = document.getElementById("featured");
      if (heroArrow && featured) {
        heroArrow.addEventListener("click", function() {
          featured.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      }

      if (articleCards.length > 0 && "IntersectionObserver" in window && !reducedMotionMedia.matches) {
        root.classList.add("reveal-enabled");
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                revealObserver.unobserve(entry.target);
              }
            });
          },
          {
            rootMargin: "0px 0px -8% 0px",
            threshold: 0.18,
          }
        );

        articleCards.forEach((card, index) => {
          card.style.setProperty("--reveal-delay", `${200 + Math.min(index % 9, 8) * 90}ms`);
          revealObserver.observe(card);
        });
      } else {
        articleCards.forEach((card) => card.classList.add("is-visible"));
      }

      window.addEventListener("scroll", syncScrollState, { passive: true });

      /* ========== 帷幕开门 ========== */
      (function curtain() {
        const KEY = 'afu-blog-curtain';
        if (sessionStorage.getItem(KEY)) return;
        if (window.innerWidth < 768) return;
        const path = window.location.pathname.replace(/\/$/, '') || '/';
        if (path !== '/' && path !== '/index.html') return;

        const OPEN_DURATION = 2000;

        const el = document.createElement('div');
        el.className = 'curtain';
        el.innerHTML = '<div class="curtain-panel left"></div><div class="curtain-panel right"></div><div class="curtain-mark">Afu\'s Blog</div>';
        document.body.appendChild(el);
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';

        const left = el.querySelector('.curtain-panel.left');
        const right = el.querySelector('.curtain-panel.right');
        const mark = el.querySelector('.curtain-mark');

        left.style.transition = 'transform ' + OPEN_DURATION + 'ms linear';
        right.style.transition = 'transform ' + OPEN_DURATION + 'ms linear';
        mark.style.transition = 'opacity ' + OPEN_DURATION + 'ms linear';

        getComputedStyle(left).transform;
        requestAnimationFrame(function() {
          left.style.transform = 'translateX(-100%)';
          right.style.transform = 'translateX(100%)';
          mark.style.opacity = '0';
        });

        setTimeout(function() {
          el.remove();
          document.documentElement.style.overflow = '';
          document.body.style.overflow = '';
          window.scrollTo(0, 0);
          sessionStorage.setItem(KEY, '1');
        }, OPEN_DURATION + 200);
      })();
    </script>
  </body>
</html>
