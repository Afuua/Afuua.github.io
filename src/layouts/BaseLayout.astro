---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const siteUrl = Astro.site?.href ?? "https://afu.im";
const ogImageUrl = ogImage ?? `${siteUrl}og-image.png`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="阿福的博客" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="alternate" type="application/rss+xml" title="阿福的博客 RSS" href="/rss.xml" />

    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <button class="back-top" type="button" title="回到顶部" data-back-top aria-label="回到顶部">
      ↑
    </button>
    <Footer />
    <script is:inline>
      const root = document.documentElement;
      const header = document.querySelector("[data-site-header]");
      const backTop = document.querySelector("[data-back-top]");
      const themeToggle = document.querySelector("[data-theme-toggle]");
      const themeIcon = document.querySelector("[data-theme-icon]");
      const readProgress = document.querySelector("[data-read-progress]");
      const homeHero = document.querySelector("[data-home-hero]");
      const articleCards = [...document.querySelectorAll(".article-card")];
      const savedTheme = localStorage.getItem("theme");
      const prefersDarkMedia = window.matchMedia("(prefers-color-scheme: dark)");
      const reducedMotionMedia = window.matchMedia("(prefers-reduced-motion: reduce)");
      const prefersDark = prefersDarkMedia.matches;

      const applyTheme = (theme) => {
        root.dataset.theme = theme;
        localStorage.setItem("theme", theme);
        if (themeIcon) themeIcon.textContent = theme === "dark" ? "☀" : "☾";
        if (themeToggle) {
          themeToggle.setAttribute("title", theme === "dark" ? "切换亮色" : "切换暗色");
        }
      };

      const syncScrollState = () => {
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const progress = maxScroll > 0 ? Math.min(1, window.scrollY / maxScroll) : 0;
        const heroHeight = homeHero?.clientHeight ?? 0;
        const heroProgress = heroHeight > 0 ? Math.min(1, window.scrollY / (heroHeight * 0.82)) : 0;
        const easedHeroProgress = 1 - Math.pow(1 - heroProgress, 2);
        header?.classList.toggle("is-scrolled", window.scrollY > 18);
        backTop?.classList.toggle("is-visible", window.scrollY > 420);
        if (readProgress) readProgress.style.transform = `scaleX(${progress})`;
        if (homeHero) {
          homeHero.style.setProperty("--hero-bg-opacity", `${Math.max(0, 1 - easedHeroProgress)}`);
          homeHero.style.setProperty("--hero-content-opacity", `${Math.max(0, 1 - heroProgress * 1.35)}`);
          homeHero.style.setProperty("--hero-content-shift", `${Math.round(heroProgress * -24)}px`);
          homeHero.style.setProperty("--hero-bg-scale", `${1.02 + heroProgress * 0.06}`);
        }
      };

      applyTheme(savedTheme === "dark" || (!savedTheme && prefersDark) ? "dark" : "light");
      syncScrollState();

      themeToggle?.addEventListener("click", () => {
        applyTheme(root.dataset.theme === "dark" ? "light" : "dark");
      });

      backTop?.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });

      if (articleCards.length > 0 && "IntersectionObserver" in window && !reducedMotionMedia.matches) {
        root.classList.add("reveal-enabled");
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                revealObserver.unobserve(entry.target);
              }
            });
          },
          {
            rootMargin: "0px 0px -8% 0px",
            threshold: 0.18,
          }
        );

        articleCards.forEach((card, index) => {
          card.style.setProperty("--reveal-delay", `${200 + Math.min(index % 9, 8) * 90}ms`);
          revealObserver.observe(card);
        });
      } else {
        articleCards.forEach((card) => card.classList.add("is-visible"));
      }

      window.addEventListener("scroll", syncScrollState, { passive: true });
    </script>
  </body>
</html>
