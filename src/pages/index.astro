---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import Pagination from "../components/Pagination.astro";
import { getAllCategories, getAllTags, paginatePosts, sortPosts } from "../utils/posts";

const posts = sortPosts(await getCollection("posts", ({ data }) => !data.draft));
const featured = posts[0];
const allTags = getAllTags(posts);
const categories = getAllCategories(posts);
const page = paginatePosts(posts, 1);
const siteStart = new Date("2026-03-04T00:00:00+08:00");
const runningDays = Math.max(1, Math.ceil((Date.now() - siteStart.getTime()) / 86400000));
---

<BaseLayout title="阿福的博客" description="写代码、聊技术、分享生活。">
  <section class="home-hero" data-home-hero>
    <div class="hero-bg" data-hero-bg></div>
    <div class="hero-content">
      <h1>Afu's Blog</h1>
      <p class="typewriter">记录技术、生活和一点点灵感闪光</p>
    </div>
    <div class="hero-arrow" data-hero-arrow title="向下滚动"></div>
  </section>

  <section class="home-layout page-shell">
    <div class="feed">
      {
        featured && (
          <section class="featured glass-card" id="featured">
            <div class="section-heading">
              <span>精选文章</span>
              <a href={`/posts/${featured.id}`}>阅读全文</a>
            </div>
            <a class="featured-item" href={`/posts/${featured.id}`}>
              <img src="/assets/home-bg.jpg?v=2" alt={featured.data.title} />
              <div>
                <h2>{featured.data.title}</h2>
                <p>{featured.data.description}</p>
                <span>
                  {featured.data.date.toLocaleDateString("zh-CN", {
                    year: "numeric",
                    month: "2-digit",
                    day: "2-digit",
                  })}
                </span>
              </div>
            </a>
          </section>
        )
      }

      <section class="category-nav" aria-label="文章分类">
        <a class="active" href="/"><span>全部</span><small>{posts.length}</small></a>
        {categories.slice(0, 4).map(([category, count]) => (
          <a href={`/categories/${category}`}><span>{category}</span><small>{count}</small></a>
        ))}
      </section>

      <section class="article-grid">
        {page.posts.length === 0 ? (
          <div class="empty glass-card">还没有文章，马上就来...</div>
        ) : (
          page.posts.map((post) => <PostCard post={post} />)
        )}
      </section>

      <Pagination currentPage={page.currentPage} totalPages={page.totalPages} />
    </div>

    <aside class="sidebar">
      <section class="sidebar-card profile-card glass-card">
        <img class="avatar" src="https://ui-avatars.com/api/?name=Afu&background=3a8dde&color=fff&size=176" alt="Afu" />
        <h3>Afu</h3>
        <p>热爱前端、文字和把复杂事情讲清楚。</p>
        <div class="socials">
          <a href="https://github.com" target="_blank" rel="noreferrer" title="GitHub">G</a>
          <a href="mailto:afu@example.com" title="Email">@</a>
          <a href="/about" title="个人页">A</a>
        </div>
      </section>
      <section class="sidebar-card stats-card glass-card">
        <h3>站点统计</h3>
        <div class="stats-grid">
          <div><strong>{posts.length}</strong><span>文章</span></div>
          <div><strong>{allTags.length}</strong><span>标签</span></div>
          <div><strong>{runningDays}</strong><span>天运行</span></div>
        </div>
      </section>
      <section class="sidebar-card glass-card">
        <h3>标签云</h3>
        <div class="tag-cloud">
          {allTags.map(([tag]) => <a href={`/tags/${tag}`}>{tag}</a>)}
        </div>
      </section>
      <section class="sidebar-card notice-card glass-card">
        <h3>公告</h3>
        <p>欢迎来到 Afu's Blog。这里记录技术笔记、项目心得与日常灵感。</p>
      </section>
    </aside>
  </section>
</BaseLayout>
