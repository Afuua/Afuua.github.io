---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllCategories, sortPosts } from "../../utils/posts";

const posts = sortPosts(await getCollection("posts", ({ data }) => !data.draft));
const categories = getAllCategories(posts);
---

<BaseLayout title="分类 - Afu的博客" description="按分类浏览文章">
  <section class="archive-page page-shell">
    <header class="page-hero glass-card">
      <div>
        <p>Categories</p>
        <h1>文章分类</h1>
      </div>
      <span>{categories.length} 个分类</span>
    </header>

    <section class="category-cards">
      {
        categories.map(([category, count]) => (
          <a class="category-card glass-card" href={`/categories/${category}`}>
            <strong>{category}</strong>
            <span>{count} 篇文章</span>
          </a>
        ))
      }
    </section>
  </section>
</BaseLayout>
