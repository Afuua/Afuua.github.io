---
const { tags, activeTag } = Astro.props;
---

<div class="flex flex-wrap gap-2">
  {
    tags.map((tag: string) => (
      <a
        href={`/tags/${tag}`}
        class={`rounded-full px-3 py-1 text-sm transition ${
          activeTag === tag
            ? "bg-blue-600 text-white"
            : "bg-gray-100 text-gray-600 hover:bg-blue-50 hover:text-blue-600"
        }`}
      >
        #{tag}
      </a>
    ))
  }
</div>
